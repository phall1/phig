{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "include-v-in-tag": true,
  "changelog-header": "# Changelog\n\nAll notable changes to phig are documented here. The format follows\n[Keep a Changelog](https://keepachangelog.com/en/1.1.0/), and releases follow\n[Semantic Versioning](https://semver.org/).",
  "changelog-sections": [
    { "type": "feat", "section": "### Added" },
    { "type": "fix", "section": "### Fixed" },
    { "type": "perf", "section": "### Changed" },
    { "type": "refactor", "section": "### Changed" },
    { "type": "chore", "section": "### Changed" },
    { "type": "docs", "hidden": true },
    { "type": "test", "hidden": true },
    { "type": "build", "hidden": true },
    { "type": "ci", "hidden": true }
  ],
  "extra-files": [
    {
      "type": "json",
      "path": "tests/fixtures/version.json",
      "jsonpath": "$.payload.version"
    }
  ],
  "packages": {
    ".": {
      "release-type": "rust"
    }
  }
}